group another_all region boundary_out

# --- Atom Properties ---
fix mass all property/atom rmass ghost yes
fix timecollide all property/atom i_tlast
fix ionlabel all property/atom i_label ghost yes
fix ion_mindist all property/atom d_mindist ghost yes

mass * ${m_ensem}
set atom * mass ${m_ensem}
set atom * i_tlast 0
set atom * i2_label -1
set atom * d_mindist 1e20
set atom * charge 0.0


# --- Velocity Initialization ---
variable Tblensem equal ${Tbl}*${scalefactor}
print "Tb0 IS ${Tb0}"
print "densem IS ${d_ensem}"
print "Max Radius IS ${MAX_RADIUS}"
print "Scalefactor IS ${scalefactor}"
print "rscalefactor IS ${rscalefactor}"
velocity all create ${Tinfty} 4928459 dist young ${Tb0} ${Tbl} ${A} ${B} ${eta} ${MAX_RADIUS_IN} ${scalefactor}

# --- Interaction Style ---
variable cutoff equal 2.0*${d_ensem}
variable cutoffcoul equal 2.0*${d_ensem}
variable cutoffio equal 1.0*$d*${halfscalefactor}
