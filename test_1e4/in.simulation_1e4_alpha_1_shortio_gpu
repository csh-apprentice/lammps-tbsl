print ">>> TBSL 1e4 alpha=1 short-ionization test" screen yes
clear
units real
package gpu 1 neigh no
dimension 3
boundary s s s
atom_style full

# --- Constants for Ar ---
variable pi equal 3.1415926
variable boltzmann equal 8.314462618
variable kB equal 1.380649e-23
variable NA equal 6.02214076e23
variable m equal 39.95
variable d equal 3.66
variable epslion_lj equal 116.81
variable epsilon equal ${boltzmann}*${epslion_lj}*0.00023901
variable epsilon_water_o equal 116.402
variable epsilon_water equal ${boltzmann}*${epsilon_water_o}*0.00023901
variable sigma equal 3.401
variable sigma_water equal 3.463

# --- Ensemble Particle Parameters ---
variable N_ensem equal 1e4
variable initialR equal 4.5e-6
variable Tinfty equal 300
variable Pinfty equal 101325
variable alpha1 equal 0.148e-6
variable V equal 4/3*${pi}*${initialR}^3
variable N equal ${Pinfty}*$V/(${kB}*${Tinfty})
variable scalefactor equal $N/${N_ensem}
variable halfscalefactor equal ${scalefactor}^(1.0/2.0)
variable rscalefactor equal ${scalefactor}^(1.0/3.0)
variable d_ensem equal ${rscalefactor}*$d
variable m_ensem equal ${scalefactor}*$m
variable epsilon_ensem equal ${epsilon}*${scalefactor}
variable epsilon_water_ensem equal ${epsilon_water}*${scalefactor}
variable sigma_ensem equal ${sigma}*${rscalefactor}
variable sigma_water_ensem equal ${sigma_water}*${rscalefactor}

# --- Bubble Initial Conditions (100 ps before collapse) ---
variable Tb0 equal 2.530107262855020e+03
variable Tbl equal 3.153042568761739e+02
variable delta equal 2520.84869818185
variable vdelta equal -2.836392012821834e-04
variable MAX_RADIUS equal 3.086969205287614e+04
variable velocitystart equal -0.00316298702544561

# --- Geometry ---
variable box_boundary equal ${MAX_RADIUS}+2*${d_ensem}
variable MAX_RADIUS_OUT equal ${MAX_RADIUS}+${d_ensem}
variable MAX_RADIUS_IN equal ${MAX_RADIUS}-${d_ensem}

# --- Heat Conduction Properties ---
variable a equal -7.69e-17
variable c equal 1.9233e-16
variable A equal 2.681e-5
variable B equal 1.346e-2
variable kl equal 0.61
variable Rb equal ${MAX_RADIUS}
variable eta equal (${Rb}/${delta})*${kl}/$B

# --- Ionization Energies ---
variable io1_ensem equal 1520.0*${scalefactor}
variable io2_ensem equal 2670.0*${scalefactor}
variable io3_ensem equal 3930.0*${scalefactor}
variable io4_ensem equal 5770.0*${scalefactor}
variable io5_ensem equal 7240.0*${scalefactor}
variable io6_ensem equal 8780.0*${scalefactor}
variable io7_ensem equal 12000.0*${scalefactor}
variable io8_ensem equal 13800.0*${scalefactor}

# --- Regions ---
region boundary sphere 0.0 0.0 0.0 ${box_boundary} side in
region boundary_out sphere 0.0 0.0 0.0 ${MAX_RADIUS_OUT} side in
region boundary_in sphere 0.0 0.0 0.0 ${MAX_RADIUS_IN} side in
region bubble_sphere sphere 0.0 0.0 0.0 ${MAX_RADIUS} side in

read_data /anvil/projects/x-phy250136/lammps-tbsl/test_1e4/initialize_lattice_1e4.lammpsdata

atom_modify sort 0 0.0

group another_all region boundary_out

fix mass all property/atom rmass ghost yes
fix timecollide all property/atom i_tlast
fix ionlabel all property/atom i_label ghost yes
fix ion_mindist all property/atom d_mindist ghost yes

mass * ${m_ensem}
set atom * mass ${m_ensem}
set atom * i_tlast 0
set atom * i2_label -1
set atom * d_mindist 1e20
set atom * charge 0.0

# --- Velocity Initialization ---
print "Scalefactor IS ${scalefactor}  rscalefactor IS ${rscalefactor}  d_ensem IS ${d_ensem}"
velocity all create ${Tinfty} 4928459 dist young ${Tb0} ${Tbl} ${A} ${B} ${eta} ${MAX_RADIUS_IN} ${scalefactor}

# --- Pair Style: LJ + short-range ionization + Coulomb DSF ---
variable cutoff equal 2.0*${d_ensem}
variable cutoffcoul equal 2.0*${d_ensem}
variable active equal true
variable alpha equal 3.0/${cutoffcoul}
pair_style lj/cutio/coul/dsf/gpu ${alpha} ${cutoff} ${cutoffcoul} ${cutoff}
pair_coeff * * 8 ${io1_ensem} ${io2_ensem} ${io3_ensem} ${io4_ensem} ${io5_ensem} ${io6_ensem} ${io7_ensem} ${io8_ensem} ${epsilon_ensem} ${sigma_ensem} v_active ${scalefactor}

set type 1 charge 0.0
comm_modify vel yes

# --- Simulation Parameters ---
variable timestep equal 1.0
# Dump every 500k steps — small files for 1e4 atoms
variable Nstep equal 5e5
variable Steps2run equal 1e7/${timestep}

# --- Checkpoints: dump for restart, keep at most 6 files (3 MB total for 1e4) ---
dump myDump all custom ${Nstep} /anvil/projects/x-phy250136/lammps-tbsl/test_1e4/dumpfiles/1e4_%.*.lammpstrj id type x y z vx vy vz fx fy fz q i_tlast i2_label d_mindist
dump_modify myDump format 3 "%.31f"
dump_modify myDump format 4 "%.31f"
dump_modify myDump format 5 "%.31f"
dump_modify myDump format 6 "%.31f"
dump_modify myDump format 7 "%.31f"
dump_modify myDump format 8 "%.31f"
dump_modify myDump format 9 "%.31f"
dump_modify myDump format 10 "%.31f"
dump_modify myDump format 11 "%.31f"

# Binary restart: alternating pair, keeps only 2 files on disk
restart 2000000 /anvil/projects/x-phy250136/lammps-tbsl/test_1e4/restart.a /anvil/projects/x-phy250136/lammps-tbsl/test_1e4/restart.b

reset_timestep 0
fix rebalance all balance 100000 1.0 shift xyz 10 1.1
timestep ${timestep}
fix 1 another_all nve

# --- KM Sphere Region ---
variable tstart equal 204790-50

variable th_radius equal 3.086969205287614*1e-06
variable th_vradius equal -3.162987025445613*1e+02
variable th_aradius equal -4.094560456322810*1e+10
variable th_Tb0 equal 2.530107262855020*1e+03
variable th_delta equal 2.520848698181851*1e-07

region km_sphere kmsphere 0.0 0.0 0.0 ${MAX_RADIUS} ${MAX_RADIUS} ${velocitystart} 1481 1000 101325 0.072 0.001 ${cutoff} 26.5e3 1.3 ${tstart} ${scalefactor} ${Tinfty} ${alpha1} ${vdelta} ${delta} ${delta} ${th_radius} ${th_vradius} ${th_aradius} ${th_Tb0} ${th_delta} 0.0 0.0 side in

# --- Observables ---
compute peratom all stress/atom NULL
variable SLradius equal slradius(all,km_sphere)
variable SLradiusold equal slradiusold(all,km_sphere)
variable innerradius equal v_SLradius-${cutoff}
region outterbubble sphere 0.0 0.0 0.0 v_SLradius side in
region innerbubble sphere 0.0 0.0 0.0 v_innerradius side out
region shell intersect 2 outterbubble innerbubble
variable RCORE equal v_SLradius/10.0
region core sphere 0.0 0.0 0.0 v_RCORE side in

variable SLvradius equal slvradius(all,km_sphere)
variable SLcount equal slcount(all,km_sphere)
variable SLpB equal slpB(all,km_sphere)
variable SLpBold equal slpBold(all,km_sphere)
variable SLpb equal slpb(all,km_sphere)
variable SLTblgas equal slgastemp(all,km_sphere)/${scalefactor}
variable SLTwall equal slwalltemp(all,km_sphere)/${scalefactor}
variable SLdelta equal sldelta(all,km_sphere)
variable SLdeltaold equal sldeltaold(all,km_sphere)
variable SLnumatoms equal slnumatoms(all,km_sphere)
variable SLvdelta equal slvdelta(all,km_sphere)
variable SLdebug equal sldebug(all,km_sphere)
variable SLsteps equal slsteps(all,km_sphere)

variable THradius equal thradius(all,km_sphere)
variable THvradius equal thvradius(all,km_sphere)
variable THaradius equal tharadius(all,km_sphere)
variable THTb0 equal thTb0(all,km_sphere)
variable THdelta equal thdelta(all,km_sphere)

compute pcore all reduce/slregion core sum c_peratom[1] c_peratom[2] c_peratom[3]
compute pshell all reduce/slregion shell sum c_peratom[1] c_peratom[2] c_peratom[3]
compute pbubble all reduce/slregion km_sphere sum c_peratom[1] c_peratom[2] c_peratom[3]
compute coretemp all temp/region core
variable corecount equal count(all,core)
variable shellcount equal count(all,shell)

variable presscore equal -(c_pcore[1]+c_pcore[2]+c_pcore[3])/(4.0*${pi}*v_RCORE^3)
variable pressshell equal -(c_pshell[1]+c_pshell[2]+c_pshell[3])/(4.0*${pi}*v_SLradius^3-4.0*${pi}*v_innerradius^3)
variable pressbubble equal -(c_pbubble[1]+c_pbubble[2]+c_pbubble[3])/(4.0*${pi}*v_SLradius^3)

# --- Radial distribution output ---
variable slvelocity atom sqrt(vx^2+vy^2+vz^2)
variable slcharge atom q
variable slvirial atom c_peratom[1]+c_peratom[2]+c_peratom[3]
compute comdis all chunk/atom bin/sphere 0.0 0.0 0.0 0.0 ${MAX_RADIUS} 100 discard yes
fix fixcomdis all ave/chunk 1000 1 1000 comdis temp v_slcharge v_slvelocity v_slvirial density/mass density/number file /anvil/projects/x-phy250136/lammps-tbsl/test_1e4/1e4_comdis_alpha_1_shortio.out

# --- Wall: alpha_t=1.0 (full heat bath) ---
fix wall all wall/mdhb km_sphere lj126 ${epsilon_water_ensem} ${sigma_water_ensem} ${cutoff} 1.0 ${scalefactor} 1000.0 4180.0 300.0 ${Tbl} ${Tbl}
fix_modify wall virial yes

# --- Adaptive timestep ---
variable tmin equal 1.0
variable tmax equal 8.0
variable estimate_max_temp equal 80000
variable estimate_max_velocity equal sqrt(${estimate_max_temp}*3.0*${kB}*${NA}*1e-7/${m})
variable estimate_Xmax equal ${estimate_max_velocity}*${tmin}
fix adaptive_step all dt/reset 1000 ${tmin} ${tmax} ${estimate_Xmax}

# --- Halt when KM integrator reaches 1e7 steps ---
fix whenhalt all halt 1000 v_SLsteps > 1e7

thermo 1000
thermo_style custom step dt time cpu temp etotal press v_pressbubble v_pressshell c_coretemp v_corecount v_presscore v_shellcount v_SLradius v_SLradiusold v_SLdebug v_SLvradius v_SLcount v_SLpB v_SLpBold v_SLpb v_SLTblgas v_SLTwall v_SLdelta v_SLdeltaold v_SLnumatoms v_SLvdelta v_SLsteps v_THradius v_THvradius v_THaradius v_THTb0 v_THdelta
thermo_modify format float "%.31f"

run ${Steps2run}
